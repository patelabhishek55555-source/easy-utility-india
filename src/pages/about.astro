---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import { siteConfig } from '../config/site';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'About Us' },
];
---

<BaseLayout
  seo={{
    title: 'About Us - Easy Utility India | Privacy-First Digital Tools',
    description: 'Learn about Easy Utility India. Our mission is to provide lightning-fast, 100% private online tools tailored for Indian students, professionals, and job applicants.',
  }}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />

    <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm space-y-8">
      <div>
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-brand-50 text-brand-700 border border-brand-200 uppercase tracking-wider inline-block mb-3">
          Our Purpose & Mission
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          About Easy Utility India
        </h1>
        <p class="text-base sm:text-lg text-slate-600 mt-3 leading-relaxed">
          <strong>{siteConfig.name}</strong> was created to address a critical frustration shared by millions of Indian students, job seekers, and everyday internet users: having to compromise the privacy of sensitive personal documents just to compress an image or merge a PDF.
        </p>
      </div>

      <!-- Core Pillars Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
        <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h2 class="font-bold text-slate-900 text-base">Privacy by Architecture</h2>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">
            Every document, photograph, and PDF is processed entirely inside your local web browser memory. Zero files are uploaded or stored on any remote cloud server.
          </p>
        </div>

        <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
          <div class="w-10 h-10 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center font-bold mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h2 class="font-bold text-slate-900 text-base">Instant Performance</h2>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">
            Because operations don't wait on slow internet file uploads or queuing servers, tools process megabytes of images and PDFs in milliseconds.
          </p>
        </div>

        <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
          <div class="w-10 h-10 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center font-bold mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />
            </svg>
          </div>
          <h2 class="font-bold text-slate-900 text-base">Tuned for India</h2>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">
            Tailored specifically for Indian government job portals (UPSC, SSC, IBPS, State PSC), academic marksheets, Aadhaar/PAN dimensions, and official GST slabs.
          </p>
        </div>
      </div>

      <!-- Story & Tech -->
      <div class="space-y-4 text-sm text-slate-700 leading-relaxed border-t border-slate-100 pt-6">
        <h2 class="text-xl font-bold text-slate-900">Why We Built This</h2>
        <p>
          Every year in India, tens of millions of aspirants register for competitive exams like SSC CGL, UPSC Civil Services, Banking (IBPS/SBI), Railways (RRB), and college admissions. Each portal enforces strict upload limitations—such as a photograph under 50KB or a signature under 20KB with exact pixel dimensions.
        </p>
        <p>
          Traditional utility websites force users to upload their intimate photographs, Aadhaar card scans, and marksheets to unknown offshore servers where data retention policies are ambiguous.
        </p>
        <p>
          <strong>Easy Utility India solves this forever:</strong> using modern WebAssembly and HTML5 Canvas technologies, all algorithms execute within your device's browser sandbox. Even if you turn off your Wi-Fi or mobile data after opening our page, the tools continue to work seamlessly!
        </p>
      </div>

      <!-- Contact Banner -->
      <div class="bg-brand-50 p-6 rounded-xl border border-brand-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="font-bold text-brand-900 text-base">Have suggestions or need a new tool?</h3>
          <p class="text-xs text-brand-700 mt-0.5">We love feedback and regularly add new utilities requested by our users.</p>
        </div>
        <a href="/contact" class="btn-primary text-xs whitespace-nowrap">
          Contact the Team
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
