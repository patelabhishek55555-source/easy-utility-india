---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact Us' },
];
---

<BaseLayout
  seo={{
    title: 'Contact Us | Easy Utility India',
    description: 'Get in touch with the Easy Utility India project. Report bugs, suggest new tools, or contribute to our open-source utility platform on GitHub.',
  }}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />

    <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm">
      <div class="max-w-2xl mb-8">
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-brand-50 text-brand-700 border border-brand-200 uppercase tracking-wider inline-block mb-3">
          Open Feedback & Support
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Contact & Community Feedback
        </h1>
        <p class="text-slate-600 mt-2 text-sm sm:text-base leading-relaxed">
          Easy Utility India is an independent, free online utility suite built for Indian students, exam candidates, and professionals. We welcome bug reports, tool requests, and suggestions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        
        <!-- Feedback Form / Generator (7 cols) -->
        <div class="md:col-span-7 space-y-4">
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
            <h2 class="text-sm font-bold text-slate-900 mb-1">Send a Message or Report an Issue</h2>
            <p class="text-xs text-slate-600 leading-relaxed">
              Fill out the details below. You can either open an issue directly on our GitHub project repository or generate a pre-filled email to send to the maintainer.
            </p>
          </div>

          <form id="contact-form" class="space-y-4">
            <div>
              <label for="contact-name" class="block text-xs font-bold text-slate-700 uppercase mb-1">Your Name</label>
              <input type="text" id="contact-name" placeholder="e.g. Ramesh" class="input-text text-sm" />
            </div>

            <div>
              <label for="contact-subject" class="block text-xs font-bold text-slate-700 uppercase mb-1">Inquiry / Topic *</label>
              <select id="contact-subject" class="input-text text-sm">
                <option value="Bug Report">Report a Tool Bug / Processing Issue</option>
                <option value="New Tool Request">Request a New Tool for Indian Exams</option>
                <option value="General Feedback">General Feedback & Suggestion</option>
                <option value="Privacy Question">Privacy or Data Query</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-bold text-slate-700 uppercase mb-1">Message Details *</label>
              <textarea id="contact-message" rows="4" required placeholder="Describe the issue, portal requirements (e.g. UPSC/SSC photo size), or tool suggestion..." class="input-text text-sm resize-none"></textarea>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 pt-2">
              <a
                id="github-issue-link"
                href="https://github.com/patelabhishek55555-source/easy-utility-india/issues/new"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary w-full text-center flex items-center justify-center gap-2"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
                <span>Open Issue on GitHub</span>
              </a>
            </div>
          </form>
        </div>

        <!-- Transparency & Contact Channel Details (5 cols) -->
        <div class="md:col-span-5 bg-slate-50 p-6 rounded-xl border border-slate-200/90 flex flex-col justify-between space-y-6">
          <div class="space-y-5">
            <h3 class="font-bold text-slate-900 text-sm uppercase tracking-wider">Project Information</h3>

            <div class="flex items-start gap-3 text-xs text-slate-600">
              <div class="w-7 h-7 rounded-lg bg-brand-100 text-brand-600 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-slate-900">Source Repository & Tracker</p>
                <a
                  href="https://github.com/patelabhishek55555-source/easy-utility-india"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-brand-600 hover:underline break-all"
                >
                  patelabhishek55555-source/easy-utility-india
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3 text-xs text-slate-600">
              <div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-slate-900">Platform Nature</p>
                <p class="text-slate-500 mt-0.5">Independent open web platform. No commercial headquarters or walk-in service centers.</p>
              </div>
            </div>

            <div class="flex items-start gap-3 text-xs text-slate-600">
              <div class="w-7 h-7 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-slate-900">Response Policy</p>
                <p class="text-slate-500 mt-0.5">Feedback and bug tickets are reviewed asynchronously by maintainers as volunteer time permits.</p>
              </div>
            </div>
          </div>

          <div class="p-4 bg-emerald-50 rounded-lg border border-emerald-200 text-xs text-emerald-800">
            <p class="font-bold">No Account or Personal Data Needed</p>
            <p class="mt-0.5 text-emerald-700">All tools are fully accessible without registration or submitting personal contact details.</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const githubLink = document.getElementById('github-issue-link') as HTMLAnchorElement | null;
  const subjectEl = document.getElementById('contact-subject') as HTMLSelectElement | null;
  const messageEl = document.getElementById('contact-message') as HTMLTextAreaElement | null;
  const nameEl = document.getElementById('contact-name') as HTMLInputElement | null;

  function updateIssueUrl() {
    if (!githubLink) return;
    const subject = subjectEl?.value || 'Feedback';
    const name = nameEl?.value ? ` by ${nameEl.value}` : '';
    const body = messageEl?.value || '';
    const title = encodeURIComponent(`[${subject}]${name}`);
    const encodedBody = encodeURIComponent(body ? `### Description:\n${body}` : '');
    githubLink.href = `https://github.com/patelabhishek55555-source/easy-utility-india/issues/new?title=${title}&body=${encodedBody}`;
  }

  subjectEl?.addEventListener('change', updateIssueUrl);
  messageEl?.addEventListener('input', updateIssueUrl);
  nameEl?.addEventListener('input', updateIssueUrl);
</script>
