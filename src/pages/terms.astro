---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Terms & Conditions' },
];
---

<BaseLayout
  seo={{
    title: 'Terms & Conditions - Easy Utility India',
    description: 'Review the Terms of Service for using Easy Utility India. Transparent, fair, and user-centric terms for our free online utility suite.',
  }}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />

    <article class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm prose prose-slate max-w-none text-slate-700 space-y-6">
      <div>
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200 uppercase tracking-wider inline-block mb-3">
          Legal Agreement
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Terms & Conditions
        </h1>
        <p class="text-xs text-slate-500 mt-2">Effective Date: November 1, 2026</p>
      </div>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900">1. Acceptance of Terms</h2>
        <p>
          By accessing or using <strong>Easy Utility India</strong> (the "Service"), you acknowledge that you have read, understood, and agree to be bound by these Terms and Conditions. If you do not agree to these terms, please discontinue use of our platform.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900">2. Description of Service</h2>
        <p>
          Easy Utility India provides free web-based utility applications, including image compression, resizing, PDF merging and splitting, and mathematical calculators. The service operates on a client-side execution model within your browser.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900">3. Permitted Use</h2>
        <p>
          You are granted a non-exclusive, revocable license to use the tools for personal, educational, professional, and commercial tasks. You agree not to attempt to reverse engineer, disrupt, inject malicious payloads, or automate scraping of our web architecture in a manner that degrades service availability.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900">4. Intellectual Property</h2>
        <p>
          You retain 100% full copyright and ownership of all files, images, PDFs, and data processed using our tools. Easy Utility India claims zero rights over your uploaded materials. All brand trademarks, website layout, code, and graphics belonging to Easy Utility India are protected under intellectual property laws.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900">5. Modifications to the Service</h2>
        <p>
          We reserve the right to improve, modify, or update features from time to time to better serve Indian users. Changes to these Terms will be posted on this page with an updated effective date.
        </p>
      </section>
    </article>
  </div>
</BaseLayout>
