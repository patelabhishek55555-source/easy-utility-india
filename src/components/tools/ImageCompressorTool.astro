---
---

<div id="image-compressor-app" class="space-y-6">
  <!-- Upload Zone -->
  <div
    id="compress-drop-zone"
    class="border-2 border-dashed border-slate-300 hover:border-brand-500 bg-slate-50 hover:bg-brand-50/30 rounded-2xl p-6 sm:p-8 text-center transition-all cursor-pointer relative"
  >
    <input
      type="file"
      id="compress-file-input"
      accept="image/jpeg,image/png,image/webp,image/jpg"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
    />
    <div class="flex flex-col items-center justify-center pointer-events-none">
      <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-brand-100 text-brand-600 flex items-center justify-center mb-3 sm:mb-4">
        <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 14h6m0 0v6m0-6L3 21m17-7h-6m0 0v6m0-6l7 7M10 10H4m6 0V4m0 6L3 3m11 7h6m-6 0V4m0 6l7-7" />
        </svg>
      </div>
      <p class="text-sm sm:text-base font-semibold text-slate-800">
        Choose an Image to Compress to Exact KB
      </p>
      <p class="text-xs text-slate-500 mt-1 max-w-sm">
        Compress JPG, PNG, or WebP down to 20KB, 50KB, 100KB for UPSC, SSC, and govt portal uploads.
      </p>
      <span class="mt-3 sm:mt-4 px-4 py-2 bg-white border border-slate-300 text-slate-700 text-xs font-semibold rounded-lg shadow-sm">
        Select Image from Device
      </span>
    </div>
  </div>

  <!-- Workspace (Hidden until image selected) -->
  <div id="compress-workspace" class="hidden space-y-6">
    
    <!-- Target KB Selection Bar -->
    <div class="bg-brand-50/70 border border-brand-200 rounded-2xl p-4 sm:p-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-3">
        <div>
          <label for="target-kb-input" class="block text-xs sm:text-sm font-bold text-slate-900">
            Target File Size (KB)
          </label>
          <p class="text-xs text-slate-600 mt-0.5">
            Specify the maximum allowed file size required by your application portal.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <input
            type="number"
            id="target-kb-input"
            value="50"
            min="5"
            max="10000"
            class="input-text w-28 text-center font-bold text-base text-brand-700 font-mono py-2"
          />
          <span class="text-sm font-bold text-slate-700">KB</span>
        </div>
      </div>

      <!-- Quick Indian Exam Presets -->
      <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap text-xs">
        <span class="text-slate-500 font-semibold">Standard Exam Limits:</span>
        <button type="button" class="kb-preset-btn px-2.5 sm:px-3 py-1.5 bg-white hover:bg-brand-600 hover:text-white text-slate-700 rounded-lg border border-slate-200 font-medium transition-all shadow-sm cursor-pointer" data-kb="20">
          20 KB (Signature)
        </button>
        <button type="button" class="kb-preset-btn px-2.5 sm:px-3 py-1.5 bg-white hover:bg-brand-600 hover:text-white text-slate-700 rounded-lg border border-slate-200 font-medium transition-all shadow-sm cursor-pointer" data-kb="50">
          50 KB (SSC/UPSC Photo)
        </button>
        <button type="button" class="kb-preset-btn px-2.5 sm:px-3 py-1.5 bg-white hover:bg-brand-600 hover:text-white text-slate-700 rounded-lg border border-slate-200 font-medium transition-all shadow-sm cursor-pointer" data-kb="100">
          100 KB (IBPS/State PSC)
        </button>
        <button type="button" class="kb-preset-btn px-2.5 sm:px-3 py-1.5 bg-white hover:bg-brand-600 hover:text-white text-slate-700 rounded-lg border border-slate-200 font-medium transition-all shadow-sm cursor-pointer" data-kb="200">
          200 KB (Certificates)
        </button>
      </div>

      <!-- Optional Dimension Customization Toggle -->
      <details class="mt-4 pt-3 border-t border-brand-200/80 group">
        <summary class="text-xs font-semibold text-brand-800 hover:text-brand-900 cursor-pointer flex items-center justify-between list-none">
          <span>Optional: Custom Dimension Limits & Aspect Ratio</span>
          <span class="group-open:rotate-180 transition-transform text-slate-400">▼</span>
        </summary>
        <div class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
          <div>
            <label for="custom-max-w" class="block text-[11px] font-bold text-slate-700 uppercase mb-1">Max Width (px)</label>
            <input type="number" id="custom-max-w" placeholder="Auto" class="input-text text-base sm:text-xs py-1.5 font-mono" />
          </div>
          <div>
            <label for="custom-max-h" class="block text-[11px] font-bold text-slate-700 uppercase mb-1">Max Height (px)</label>
            <input type="number" id="custom-max-h" placeholder="Auto" class="input-text text-base sm:text-xs py-1.5 font-mono" />
          </div>
          <div class="flex items-center pt-4">
            <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
              <input type="checkbox" id="compress-keep-aspect" checked class="w-4 h-4 text-brand-600 rounded border-slate-300" />
              <span>Lock Aspect Ratio</span>
            </label>
          </div>
        </div>
      </details>
    </div>

    <!-- Live Comparison & Metrics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      
      <!-- Original Card -->
      <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex flex-col">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Original File</span>
          <span id="orig-size-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700">0 KB</span>
        </div>
        <div class="h-48 sm:h-56 bg-slate-50 rounded-lg flex items-center justify-center overflow-hidden mb-3 p-2">
          <img id="orig-preview-img" alt="Original" class="max-h-full max-w-full object-contain rounded" />
        </div>
        <p id="orig-meta-text" class="text-xs text-slate-500 text-center font-medium"></p>
      </div>

      <!-- Compressed Result Card -->
      <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex flex-col">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-brand-600 uppercase tracking-wider">Compressed File</span>
            <span id="savings-badge" class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 hidden"></span>
          </div>
          <span id="comp-size-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-100 text-brand-800">Pending</span>
        </div>
        <div class="h-48 sm:h-56 bg-slate-50 rounded-lg flex items-center justify-center overflow-hidden mb-3 p-2 relative">
          <img id="comp-preview-img" alt="Compressed" class="max-h-full max-w-full object-contain rounded hidden" />
          <div id="comp-placeholder" class="text-center text-slate-400 text-xs px-4">
            Click "Compress Image" to calculate optimal compression
          </div>
        </div>
        <p id="comp-meta-text" class="text-xs text-slate-500 text-center font-medium"></p>
      </div>

    </div>

    <!-- Compression Analysis / Explanation Alert -->
    <div id="compression-note-box" class="hidden p-4 rounded-xl text-xs sm:text-sm leading-relaxed border"></div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-slate-200">
      <button id="compress-reset-btn" type="button" class="btn-secondary w-full sm:w-auto">
        Change Image
      </button>

      <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
        <button id="run-compress-btn" type="button" class="btn-primary w-full sm:w-auto">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Compress to Target KB</span>
        </button>

        <button id="download-compressed-btn" type="button" class="btn-primary bg-emerald-600 hover:bg-emerald-700 focus:ring-emerald-500 w-full sm:w-auto hidden">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Download Compressed Image</span>
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  import { compressImageToTargetKB, type CompressionResult } from '../../utils/imageHelpers';

  let originalFile: File | null = null;
  let latestResult: CompressionResult | null = null;

  const dropZone = document.getElementById('compress-drop-zone');
  const fileInput = document.getElementById('compress-file-input') as HTMLInputElement | null;
  const workspace = document.getElementById('compress-workspace');
  const targetKbInput = document.getElementById('target-kb-input') as HTMLInputElement | null;
  const customMaxW = document.getElementById('custom-max-w') as HTMLInputElement | null;
  const customMaxH = document.getElementById('custom-max-h') as HTMLInputElement | null;
  const keepAspect = document.getElementById('compress-keep-aspect') as HTMLInputElement | null;
  const origSizeBadge = document.getElementById('orig-size-badge');
  const origPreviewImg = document.getElementById('orig-preview-img') as HTMLImageElement | null;
  const origMetaText = document.getElementById('orig-meta-text');
  const compSizeBadge = document.getElementById('comp-size-badge');
  const compPreviewImg = document.getElementById('comp-preview-img') as HTMLImageElement | null;
  const compPlaceholder = document.getElementById('comp-placeholder');
  const compMetaText = document.getElementById('comp-meta-text');
  const savingsBadge = document.getElementById('savings-badge');
  const noteBox = document.getElementById('compression-note-box');
  const runCompressBtn = document.getElementById('run-compress-btn');
  const downloadBtn = document.getElementById('download-compressed-btn');
  const resetBtn = document.getElementById('compress-reset-btn');
  const presetBtns = document.querySelectorAll<HTMLButtonElement>('.kb-preset-btn');

  function handleImageFile(file: File) {
    if (!file || !file.type.startsWith('image/')) return;

    originalFile = file;
    const origKB = Math.round((file.size / 1024) * 10) / 10;
    const previewUrl = URL.createObjectURL(file);

    const img = new Image();
    img.onload = () => {
      if (origSizeBadge) origSizeBadge.textContent = `${origKB} KB`;
      if (origPreviewImg) origPreviewImg.src = previewUrl;
      if (origMetaText) origMetaText.textContent = `${img.naturalWidth} × ${img.naturalHeight} px • ${file.type.split('/')[1].toUpperCase()}`;

      dropZone?.classList.add('hidden');
      workspace?.classList.remove('hidden');

      if (targetKbInput) {
        if (origKB <= 50) {
          targetKbInput.value = '20';
        } else if (origKB <= 200) {
          targetKbInput.value = '50';
        } else {
          targetKbInput.value = '100';
        }
      }

      executeCompression();
    };
    img.src = previewUrl;
  }

  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const kb = btn.dataset.kb;
      if (kb && targetKbInput) {
        targetKbInput.value = kb;
        executeCompression();
      }
    });
  });

  async function executeCompression() {
    if (!originalFile || !targetKbInput) return;

    const targetKB = parseInt(targetKbInput.value, 10);
    if (isNaN(targetKB) || targetKB < 5) {
      alert('Please enter a valid target size (minimum 5 KB).');
      return;
    }

    try {
      if (runCompressBtn) {
        runCompressBtn.setAttribute('disabled', 'true');
        runCompressBtn.textContent = 'Compressing...';
      }

      const options = {
        maxWidth: customMaxW?.value ? parseInt(customMaxW.value, 10) : undefined,
        maxHeight: customMaxH?.value ? parseInt(customMaxH.value, 10) : undefined,
        maintainAspectRatio: keepAspect ? keepAspect.checked : true,
      };

      const result = await compressImageToTargetKB(originalFile, targetKB, 'image/jpeg', options);
      latestResult = result;

      if (compPreviewImg && compPlaceholder) {
        compPreviewImg.src = result.dataUrl;
        compPreviewImg.classList.remove('hidden');
        compPlaceholder.classList.add('hidden');
      }

      if (compSizeBadge) {
        compSizeBadge.textContent = `${result.finalKB} KB`;
        if (result.reachedTarget) {
          compSizeBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800';
        } else {
          compSizeBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800';
        }
      }

      if (compMetaText) {
        compMetaText.textContent = `${result.width} × ${result.height} px • Quality ${result.quality}%`;
      }

      const origBytes = originalFile.size;
      const compBytes = result.blob.size;
      const savedPercent = Math.max(0, Math.round(((origBytes - compBytes) / origBytes) * 100));
      if (savingsBadge) {
        savingsBadge.classList.remove('hidden');
        savingsBadge.textContent = `-${savedPercent}% Saved`;
      }

      if (noteBox) {
        noteBox.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-900', 'border-emerald-200', 'bg-amber-50', 'text-amber-900', 'border-amber-200');
        if (result.reachedTarget) {
          noteBox.classList.add('bg-emerald-50', 'text-emerald-900', 'border-emerald-200');
          noteBox.innerHTML = `
            <div class="flex items-start gap-2.5">
              <svg class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <p class="font-bold">Target size achieved: ${result.finalKB} KB (Target: ≤ ${targetKB} KB)</p>
                <p class="text-xs text-emerald-700 mt-0.5">${result.notes} File is fully compliant for submission.</p>
              </div>
            </div>
          `;
        } else {
          noteBox.classList.add('bg-amber-50', 'text-amber-900', 'border-amber-200');
          noteBox.innerHTML = `
            <div class="flex items-start gap-2.5">
              <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div>
                <p class="font-bold">Why target size (${targetKB} KB) was not fully reached:</p>
                <p class="text-xs text-amber-800 mt-0.5">${result.notes} Compressing further would cause unacceptable visual distortion. Increase your target slightly or crop unnecessary margins.</p>
              </div>
            </div>
          `;
        }
      }

      downloadBtn?.classList.remove('hidden');
    } catch (err: any) {
      console.error(err);
      alert('Error compressing image: ' + err.message);
    } finally {
      if (runCompressBtn) {
        runCompressBtn.removeAttribute('disabled');
        runCompressBtn.innerHTML = `
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Compress to Target KB</span>
        `;
      }
    }
  }

  runCompressBtn?.addEventListener('click', executeCompression);
  targetKbInput?.addEventListener('change', executeCompression);
  customMaxW?.addEventListener('change', executeCompression);
  customMaxH?.addEventListener('change', executeCompression);
  keepAspect?.addEventListener('change', executeCompression);

  downloadBtn?.addEventListener('click', () => {
    if (!latestResult || !originalFile) return;

    const baseName = originalFile.name.replace(/\.[^/.]+$/, '');
    const link = document.createElement('a');
    link.href = latestResult.dataUrl;
    link.download = `${baseName}_compressed_${latestResult.finalKB}KB.jpg`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    setTimeout(() => URL.revokeObjectURL(latestResult!.dataUrl), 5000);
  });

  resetBtn?.addEventListener('click', () => {
    originalFile = null;
    latestResult = null;
    dropZone?.classList.remove('hidden');
    workspace?.classList.add('hidden');
    downloadBtn?.classList.add('hidden');
  });

  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files[0]) {
      handleImageFile(target.files[0]);
    }
    target.value = '';
  });

  ['dragenter', 'dragover'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.add('border-brand-500', 'bg-brand-50/50');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-brand-500', 'bg-brand-50/50');
    });
  });

  dropZone?.addEventListener('drop', (e) => {
    const dt = e.dataTransfer;
    if (dt && dt.files && dt.files[0]) {
      handleImageFile(dt.files[0]);
    }
  });
</script>
