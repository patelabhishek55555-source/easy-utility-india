---
---

<div id="image-to-pdf-app" class="space-y-6">
  <!-- Upload Zone -->
  <div
    id="drop-zone"
    class="border-2 border-dashed border-slate-300 hover:border-brand-500 bg-slate-50 hover:bg-brand-50/30 rounded-2xl p-6 sm:p-8 text-center transition-all cursor-pointer relative"
  >
    <input
      type="file"
      id="file-input"
      multiple
      accept="image/jpeg,image/png,image/webp,image/jpg"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
    />
    <div class="flex flex-col items-center justify-center pointer-events-none">
      <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-brand-100 text-brand-600 flex items-center justify-center mb-3 sm:mb-4">
        <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <p class="text-sm sm:text-base font-semibold text-slate-800">
        Choose Images or drag & drop them here
      </p>
      <p class="text-xs text-slate-500 mt-1 max-w-sm">
        Supports JPG, PNG, and WebP. Multi-image selection supported.
      </p>
      <span class="mt-3 sm:mt-4 px-4 py-2 bg-white border border-slate-300 text-slate-700 text-xs font-semibold rounded-lg shadow-sm">
        Browse Files from Device
      </span>
    </div>
  </div>

  <!-- Settings & Action Panel (Hidden until files are loaded) -->
  <div id="action-panel" class="hidden space-y-6">
    
    <!-- Controls Row -->
    <div class="bg-slate-50 p-4 sm:p-5 rounded-xl border border-slate-200 grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
      <div>
        <label for="page-size" class="block text-xs font-semibold text-slate-700 uppercase mb-1.5">Page Size</label>
        <select id="page-size" class="input-text text-base sm:text-sm py-2">
          <option value="a4" selected>A4 (210 × 297 mm)</option>
          <option value="letter">US Letter (8.5 × 11 in)</option>
          <option value="fit">Fit to Image Size</option>
        </select>
      </div>

      <div>
        <label for="orientation" class="block text-xs font-semibold text-slate-700 uppercase mb-1.5">Orientation</label>
        <select id="orientation" class="input-text text-base sm:text-sm py-2">
          <option value="portrait" selected>Portrait</option>
          <option value="landscape">Landscape</option>
          <option value="auto">Auto (Match Image)</option>
        </select>
      </div>

      <div>
        <label for="margin" class="block text-xs font-semibold text-slate-700 uppercase mb-1.5">Margin</label>
        <select id="margin" class="input-text text-base sm:text-sm py-2">
          <option value="0">No Margin (0 mm)</option>
          <option value="15" selected>Small Margin (5 mm)</option>
          <option value="30">Normal Margin (10 mm)</option>
        </select>
      </div>
    </div>

    <!-- Image Thumbnails Grid / List -->
    <div>
      <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
        <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
          <span>Selected Images</span>
          <span id="selected-count-badge" class="px-2 py-0.5 text-xs bg-brand-100 text-brand-800 rounded-full font-bold">0</span>
        </h3>
        
        <div class="flex items-center gap-3">
          <label for="add-more-input" class="text-xs text-brand-600 hover:text-brand-800 font-bold cursor-pointer inline-flex items-center gap-1">
            <span>+ Add More Photos</span>
            <input type="file" id="add-more-input" multiple accept="image/jpeg,image/png,image/webp,image/jpg" class="hidden" />
          </label>
          <span class="text-slate-300">|</span>
          <button id="clear-all-btn" type="button" class="text-xs text-rose-600 hover:text-rose-800 font-semibold cursor-pointer">
            Clear All
          </button>
        </div>
      </div>
      <div id="image-list" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4"></div>
    </div>

    <!-- Status Alert / Progress -->
    <div id="status-container" class="hidden p-4 rounded-xl text-xs sm:text-sm font-medium"></div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-end gap-3 pt-4 border-t border-slate-200">
      <button id="reset-btn" type="button" class="btn-secondary w-full sm:w-auto">
        Reset
      </button>
      <button id="convert-btn" type="button" class="btn-primary w-full sm:w-auto">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Generate & Download PDF</span>
      </button>
    </div>

  </div>
</div>

<script>
  import { PDFDocument } from 'pdf-lib';

  interface ImageItem {
    id: string;
    file: File;
    previewUrl: string;
    width: number;
    height: number;
  }

  let images: ImageItem[] = [];

  const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
  const addMoreInput = document.getElementById('add-more-input') as HTMLInputElement | null;
  const dropZone = document.getElementById('drop-zone');
  const actionPanel = document.getElementById('action-panel');
  const imageList = document.getElementById('image-list');
  const selectedCountBadge = document.getElementById('selected-count-badge');
  const clearAllBtn = document.getElementById('clear-all-btn');
  const resetBtn = document.getElementById('reset-btn');
  const convertBtn = document.getElementById('convert-btn');
  const statusContainer = document.getElementById('status-container');
  const pageSizeSelect = document.getElementById('page-size') as HTMLSelectElement | null;
  const orientationSelect = document.getElementById('orientation') as HTMLSelectElement | null;
  const marginSelect = document.getElementById('margin') as HTMLSelectElement | null;

  async function handleFiles(files: FileList | null) {
    if (!files || files.length === 0) return;

    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      if (!file.type.startsWith('image/')) continue;

      const previewUrl = URL.createObjectURL(file);
      const img = new Image();
      img.src = previewUrl;

      const loaded = await new Promise<boolean>((res) => {
        img.onload = () => res(true);
        img.onerror = () => res(false);
      });

      if (!loaded) {
        URL.revokeObjectURL(previewUrl);
        continue;
      }

      images.push({
        id: Math.random().toString(36).substring(2, 9),
        file,
        previewUrl,
        width: img.naturalWidth || 800,
        height: img.naturalHeight || 600,
      });
    }

    renderImageList();
  }

  function renderImageList() {
    if (!imageList || !actionPanel || !selectedCountBadge) return;

    if (images.length === 0) {
      actionPanel.classList.add('hidden');
      imageList.innerHTML = '';
      selectedCountBadge.textContent = '0';
      return;
    }

    actionPanel.classList.remove('hidden');
    selectedCountBadge.textContent = images.length.toString();
    imageList.innerHTML = '';

    images.forEach((item, index) => {
      const card = document.createElement('div');
      card.className = 'relative bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm group';
      card.innerHTML = `
        <div class="h-28 sm:h-32 bg-slate-100 flex items-center justify-center overflow-hidden">
          <img src="${item.previewUrl}" alt="Preview" class="object-cover w-full h-full" />
        </div>
        <div class="p-2 flex items-center justify-between text-xs text-slate-600 bg-slate-50">
          <span class="font-bold text-slate-800">#${index + 1}</span>
          <span class="truncate max-w-[70px] sm:max-w-[90px]" title="${item.file.name}">${item.file.name}</span>
          <div class="flex items-center gap-1">
            ${index > 0 ? `<button type="button" class="move-up-btn p-1 text-slate-500 hover:text-brand-600 cursor-pointer" data-idx="${index}" title="Move up">▲</button>` : ''}
            ${index < images.length - 1 ? `<button type="button" class="move-down-btn p-1 text-slate-500 hover:text-brand-600 cursor-pointer" data-idx="${index}" title="Move down">▼</button>` : ''}
            <button type="button" class="remove-btn p-1 text-rose-500 hover:text-rose-700 font-bold cursor-pointer" data-idx="${index}" title="Remove">✕</button>
          </div>
        </div>
      `;
      imageList.appendChild(card);
    });

    // Reattach listeners
    imageList.querySelectorAll<HTMLButtonElement>('.move-up-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(btn.dataset.idx || '0', 10);
        if (idx > 0) {
          const temp = images[idx];
          images[idx] = images[idx - 1];
          images[idx - 1] = temp;
          renderImageList();
        }
      });
    });

    imageList.querySelectorAll<HTMLButtonElement>('.move-down-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(btn.dataset.idx || '0', 10);
        if (idx < images.length - 1) {
          const temp = images[idx];
          images[idx] = images[idx + 1];
          images[idx + 1] = temp;
          renderImageList();
        }
      });
    });

    imageList.querySelectorAll<HTMLButtonElement>('.remove-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(btn.dataset.idx || '0', 10);
        URL.revokeObjectURL(images[idx].previewUrl);
        images.splice(idx, 1);
        renderImageList();
      });
    });
  }

  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    handleFiles(target.files);
    target.value = '';
  });

  addMoreInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    handleFiles(target.files);
    target.value = '';
  });

  ['dragenter', 'dragover'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.add('border-brand-500', 'bg-brand-50/50');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-brand-500', 'bg-brand-50/50');
    });
  });

  dropZone?.addEventListener('drop', (e) => {
    const dt = e.dataTransfer;
    if (dt && dt.files) {
      handleFiles(dt.files);
    }
  });

  function clearAllImages() {
    images.forEach((img) => URL.revokeObjectURL(img.previewUrl));
    images = [];
    renderImageList();
    if (statusContainer) statusContainer.classList.add('hidden');
  }

  clearAllBtn?.addEventListener('click', clearAllImages);
  resetBtn?.addEventListener('click', clearAllImages);

  function showStatus(msg: string, isError: boolean = false) {
    if (!statusContainer) return;
    statusContainer.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-800', 'border-emerald-200', 'bg-rose-50', 'text-rose-800', 'border-rose-200');
    if (isError) {
      statusContainer.classList.add('bg-rose-50', 'text-rose-800', 'border', 'border-rose-200');
    } else {
      statusContainer.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
    }
    statusContainer.innerHTML = msg;
  }

  // Convert canvas to standard JPEG buffer for foolproof pdf-lib embedding
  async function imageToJpegBuffer(imgItem: ImageItem): Promise<ArrayBuffer> {
    const canvas = document.createElement('canvas');
    canvas.width = imgItem.width;
    canvas.height = imgItem.height;
    const ctx = canvas.getContext('2d');
    if (ctx) {
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      const tempImg = new Image();
      tempImg.src = imgItem.previewUrl;
      await new Promise((res) => { tempImg.onload = res; });
      ctx.drawImage(tempImg, 0, 0);
    }
    const blob = await new Promise<Blob>((resolve) => canvas.toBlob((b) => resolve(b!), 'image/jpeg', 0.92));
    return await blob.arrayBuffer();
  }

  convertBtn?.addEventListener('click', async () => {
    if (images.length === 0) return;

    try {
      convertBtn.setAttribute('disabled', 'true');
      showStatus('Compiling PDF in browser memory... Please wait.');

      const pdfDoc = await PDFDocument.create();
      const pageSize = pageSizeSelect?.value || 'a4';
      const orientation = orientationSelect?.value || 'portrait';
      const margin = parseInt(marginSelect?.value || '15', 10);

      for (let i = 0; i < images.length; i++) {
        const item = images[i];
        let embeddedImage;

        // Try direct embedding first for raw performance
        try {
          const rawBuffer = await item.file.arrayBuffer();
          if (item.file.type === 'image/png') {
            embeddedImage = await pdfDoc.embedPng(rawBuffer);
          } else if (item.file.type === 'image/jpeg' || item.file.type === 'image/jpg') {
            embeddedImage = await pdfDoc.embedJpg(rawBuffer);
          } else {
            const fallbackBuffer = await imageToJpegBuffer(item);
            embeddedImage = await pdfDoc.embedJpg(fallbackBuffer);
          }
        } catch {
          // If direct embed fails due to color space/chunk, use canvas fallback
          const fallbackBuffer = await imageToJpegBuffer(item);
          embeddedImage = await pdfDoc.embedJpg(fallbackBuffer);
        }

        const imgWidth = embeddedImage.width;
        const imgHeight = embeddedImage.height;

        let pageWidth = 595.28; // A4 standard pt
        let pageHeight = 841.89;

        if (pageSize === 'letter') {
          pageWidth = 612;
          pageHeight = 792;
        } else if (pageSize === 'fit') {
          // Standardize DPI to ~72-96 pt
          const scaleRatio = Math.max(imgWidth, imgHeight) > 1200 ? 0.5 : 1;
          pageWidth = (imgWidth * scaleRatio) + margin * 2;
          pageHeight = (imgHeight * scaleRatio) + margin * 2;
        }

        if (pageSize !== 'fit') {
          if (orientation === 'landscape' || (orientation === 'auto' && imgWidth > imgHeight)) {
            const temp = pageWidth;
            pageWidth = pageHeight;
            pageHeight = temp;
          }
        }

        const page = pdfDoc.addPage([pageWidth, pageHeight]);

        const availWidth = pageWidth - margin * 2;
        const availHeight = pageHeight - margin * 2;

        const scale = Math.min(availWidth / imgWidth, availHeight / imgHeight);
        const drawWidth = imgWidth * scale;
        const drawHeight = imgHeight * scale;

        const x = margin + (availWidth - drawWidth) / 2;
        const y = margin + (availHeight - drawHeight) / 2;

        page.drawImage(embeddedImage, {
          x,
          y,
          width: drawWidth,
          height: drawHeight,
        });
      }

      const pdfBytes = await pdfDoc.save();
      const blob = new Blob([pdfBytes], { type: 'application/pdf' });
      const downloadUrl = URL.createObjectURL(blob);

      const link = document.createElement('a');
      link.href = downloadUrl;
      link.download = `EasyUtility_Images_${images.length}pages_${Date.now()}.pdf`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      setTimeout(() => URL.revokeObjectURL(downloadUrl), 5000);
      showStatus(`✓ Success! Generated PDF with ${images.length} pages. Download started automatically.`);
    } catch (err: any) {
      console.error(err);
      showStatus(`Error generating PDF: ${err.message || 'Unknown error occurred'}`, true);
    } finally {
      convertBtn.removeAttribute('disabled');
    }
  });
</script>
