---
---

<div id="split-pdf-app" class="space-y-6">
  <!-- Upload Zone -->
  <div
    id="split-drop-zone"
    class="border-2 border-dashed border-slate-300 hover:border-brand-500 bg-slate-50 hover:bg-brand-50/30 rounded-2xl p-6 sm:p-8 text-center transition-all cursor-pointer relative"
  >
    <input
      type="file"
      id="split-file-input"
      accept="application/pdf,.pdf"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
    />
    <div class="flex flex-col items-center justify-center pointer-events-none">
      <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-brand-100 text-brand-600 flex items-center justify-center mb-3 sm:mb-4">
        <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
        </svg>
      </div>
      <p class="text-sm sm:text-base font-semibold text-slate-800">
        Choose a PDF File to Split
      </p>
      <p class="text-xs text-slate-500 mt-1 max-w-sm">
        Extract specific pages or page ranges into a new PDF document.
      </p>
      <span class="mt-3 sm:mt-4 px-4 py-2 bg-white border border-slate-300 text-slate-700 text-xs font-semibold rounded-lg shadow-sm">
        Select PDF File
      </span>
    </div>
  </div>

  <!-- Configuration Workspace (Hidden until file selected) -->
  <div id="split-workspace" class="hidden space-y-6">
    <!-- File Information Card -->
    <div class="bg-slate-50 rounded-xl border border-slate-200 p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-10 h-10 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center flex-shrink-0 font-bold text-xs">
          PDF
        </div>
        <div class="min-w-0">
          <h4 id="file-info-name" class="font-bold text-slate-900 text-xs sm:text-sm truncate max-w-xs sm:max-w-md"></h4>
          <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5">
            Size: <span id="file-info-size" class="font-medium text-slate-700"></span> • 
            Total Pages: <span id="file-info-pages" class="font-bold text-brand-600"></span>
          </p>
        </div>
      </div>
      <button id="split-change-file-btn" type="button" class="btn-secondary text-xs self-start sm:self-auto cursor-pointer">
        Change File
      </button>
    </div>

    <!-- Page Range Input -->
    <div class="bg-white rounded-xl border border-slate-200 p-4 sm:p-5 space-y-4">
      <div>
        <label for="page-range-input" class="block text-xs sm:text-sm font-bold text-slate-900 mb-1">
          Pages to Extract
        </label>
        <p class="text-xs text-slate-500 mb-2">
          Enter page numbers and/or ranges separated by commas. For example: <span class="font-mono font-semibold text-slate-700">1-3, 5, 8-10</span>
        </p>
        <input
          type="text"
          id="page-range-input"
          class="input-text text-base font-mono"
          placeholder="e.g. 1-3, 5"
        />
      </div>

      <!-- Quick Preset Buttons -->
      <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap text-xs">
        <span class="text-slate-500 font-medium">Quick Select:</span>
        <button type="button" class="preset-btn px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition-colors font-medium cursor-pointer" data-preset="first">
          Page 1 Only
        </button>
        <button type="button" class="preset-btn px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition-colors font-medium cursor-pointer" data-preset="last">
          Last Page
        </button>
        <button type="button" class="preset-btn px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition-colors font-medium cursor-pointer" data-preset="all">
          All Pages
        </button>
        <button type="button" class="preset-btn px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition-colors font-medium cursor-pointer" data-preset="odd">
          Odd Pages
        </button>
        <button type="button" class="preset-btn px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition-colors font-medium cursor-pointer" data-preset="even">
          Even Pages
        </button>
      </div>

      <!-- Live Preview of Parsed Pages -->
      <div id="parsed-summary" class="text-xs text-slate-600 bg-slate-50 p-3 rounded-lg border border-slate-200 flex flex-col gap-1">
        <div>Parsed selection: <span id="parsed-pages-text" class="font-semibold text-slate-900">None</span></div>
        <div id="out-of-bounds-warning" class="text-amber-700 font-medium hidden"></div>
      </div>
    </div>

    <!-- Status Alerts -->
    <div id="split-status-container" class="hidden p-4 rounded-xl text-xs sm:text-sm font-medium"></div>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-end gap-3 pt-4 border-t border-slate-200">
      <button id="split-reset-btn" type="button" class="btn-secondary w-full sm:w-auto">
        Reset
      </button>
      <button id="split-execute-btn" type="button" class="btn-primary w-full sm:w-auto">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Extract & Download PDF</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { PDFDocument } from 'pdf-lib';

  let currentFile: File | null = null;
  let totalPageCount = 0;

  const fileInput = document.getElementById('split-file-input') as HTMLInputElement | null;
  const dropZone = document.getElementById('split-drop-zone');
  const workspace = document.getElementById('split-workspace');
  const fileNameEl = document.getElementById('file-info-name');
  const fileSizeEl = document.getElementById('file-info-size');
  const filePagesEl = document.getElementById('file-info-pages');
  const rangeInput = document.getElementById('page-range-input') as HTMLInputElement | null;
  const parsedPagesText = document.getElementById('parsed-pages-text');
  const outOfBoundsWarning = document.getElementById('out-of-bounds-warning');
  const statusContainer = document.getElementById('split-status-container');
  const executeBtn = document.getElementById('split-execute-btn');
  const resetBtn = document.getElementById('split-reset-btn');
  const changeFileBtn = document.getElementById('split-change-file-btn');
  const presetBtns = document.querySelectorAll<HTMLButtonElement>('.preset-btn');

  function formatBytes(bytes: number) {
    if (bytes === 0) return '0 KB';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  async function loadPdfFile(file: File) {
    if (!file || (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf'))) {
      showStatus('Please select a valid PDF file.', true);
      return;
    }

    try {
      showStatus('Analyzing PDF structure in memory...');
      const buffer = await file.arrayBuffer();
      const doc = await PDFDocument.load(buffer, { ignoreEncryption: false });
      totalPageCount = doc.getPageCount();

      currentFile = file;

      if (fileNameEl) fileNameEl.textContent = file.name;
      if (fileSizeEl) fileSizeEl.textContent = formatBytes(file.size);
      if (filePagesEl) filePagesEl.textContent = totalPageCount.toString();

      dropZone?.classList.add('hidden');
      workspace?.classList.remove('hidden');
      statusContainer?.classList.add('hidden');

      if (rangeInput) {
        rangeInput.value = totalPageCount === 1 ? '1' : `1-${Math.min(totalPageCount, 3)}`;
        updateParsedPages();
      }
    } catch (err: any) {
      console.error(err);
      const isPassword = err?.message?.toLowerCase().includes('password') || err?.message?.toLowerCase().includes('encrypted');
      if (isPassword) {
        showStatus(`"${file.name}" is password-protected. Please unlock it before extracting pages.`, true);
      } else {
        showStatus(`Failed to read PDF: ${err.message || 'File may be corrupted.'}`, true);
      }
    }
  }

  function parsePageRange(input: string, maxPages: number): { pages: number[], outOfBounds: number[] } {
    const pages = new Set<number>();
    const outOfBounds = new Set<number>();
    const parts = input.split(',').map((s) => s.trim()).filter(Boolean);

    for (const part of parts) {
      if (part.includes('-')) {
        const [startStr, endStr] = part.split('-').map((s) => s.trim());
        let start = parseInt(startStr, 10);
        let end = parseInt(endStr, 10);

        if (!isNaN(start) && !isNaN(end)) {
          // If user wrote reverse e.g. 5-1, normalize to 1-5
          if (start > end) {
            const temp = start;
            start = end;
            end = temp;
          }

          for (let p = Math.max(1, start); p <= end; p++) {
            if (p <= maxPages) {
              pages.add(p);
            } else {
              outOfBounds.add(p);
            }
          }
        }
      } else {
        const p = parseInt(part, 10);
        if (!isNaN(p) && p >= 1) {
          if (p <= maxPages) {
            pages.add(p);
          } else {
            outOfBounds.add(p);
          }
        }
      }
    }

    return {
      pages: Array.from(pages).sort((a, b) => a - b),
      outOfBounds: Array.from(outOfBounds).sort((a, b) => a - b),
    };
  }

  function updateParsedPages() {
    if (!rangeInput || !parsedPagesText) return;
    const { pages, outOfBounds } = parsePageRange(rangeInput.value, totalPageCount);

    if (pages.length === 0) {
      parsedPagesText.textContent = 'No valid pages selected';
      parsedPagesText.className = 'font-semibold text-rose-600';
    } else {
      parsedPagesText.textContent = `${pages.length} page${pages.length === 1 ? '' : 's'} (${pages.join(', ')})`;
      parsedPagesText.className = 'font-semibold text-slate-900';
    }

    if (outOfBoundsWarning) {
      if (outOfBounds.length > 0) {
        outOfBoundsWarning.classList.remove('hidden');
        outOfBoundsWarning.textContent = `⚠ Note: Page(s) ${outOfBounds.join(', ')} exceed total pages (${totalPageCount}) and will be omitted.`;
      } else {
        outOfBoundsWarning.classList.add('hidden');
      }
    }
  }

  rangeInput?.addEventListener('input', updateParsedPages);

  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!rangeInput || totalPageCount === 0) return;
      const preset = btn.dataset.preset;
      if (preset === 'first') {
        rangeInput.value = '1';
      } else if (preset === 'last') {
        rangeInput.value = totalPageCount.toString();
      } else if (preset === 'all') {
        rangeInput.value = `1-${totalPageCount}`;
      } else if (preset === 'even') {
        const evens: number[] = [];
        for (let i = 2; i <= totalPageCount; i += 2) evens.push(i);
        rangeInput.value = evens.join(', ');
      } else if (preset === 'odd') {
        const odds: number[] = [];
        for (let i = 1; i <= totalPageCount; i += 2) odds.push(i);
        rangeInput.value = odds.join(', ');
      }
      updateParsedPages();
    });
  });

  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files[0]) {
      loadPdfFile(target.files[0]);
    }
    target.value = '';
  });

  ['dragenter', 'dragover'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.add('border-brand-500', 'bg-brand-50/50');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-brand-500', 'bg-brand-50/50');
    });
  });

  dropZone?.addEventListener('drop', (e) => {
    const dt = e.dataTransfer;
    if (dt && dt.files && dt.files[0]) {
      loadPdfFile(dt.files[0]);
    }
  });

  function resetState() {
    currentFile = null;
    totalPageCount = 0;
    dropZone?.classList.remove('hidden');
    workspace?.classList.add('hidden');
    statusContainer?.classList.add('hidden');
    if (rangeInput) rangeInput.value = '';
  }

  resetBtn?.addEventListener('click', resetState);
  changeFileBtn?.addEventListener('click', resetState);

  function showStatus(msg: string, isError: boolean = false) {
    if (!statusContainer) return;
    statusContainer.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-800', 'border-emerald-200', 'bg-rose-50', 'text-rose-800', 'border-rose-200');
    if (isError) {
      statusContainer.classList.add('bg-rose-50', 'text-rose-800', 'border', 'border-rose-200');
    } else {
      statusContainer.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
    }
    statusContainer.innerHTML = msg;
  }

  executeBtn?.addEventListener('click', async () => {
    if (!currentFile || !rangeInput) return;

    const { pages: selectedPages } = parsePageRange(rangeInput.value, totalPageCount);
    if (selectedPages.length === 0) {
      showStatus('Please specify at least one valid page number to extract.', true);
      return;
    }

    try {
      executeBtn.setAttribute('disabled', 'true');
      showStatus('Extracting selected pages...');

      const buffer = await currentFile.arrayBuffer();
      const srcDoc = await PDFDocument.load(buffer);
      const newDoc = await PDFDocument.create();

      const pageIndices = selectedPages.map((p) => p - 1);
      const copiedPages = await newDoc.copyPages(srcDoc, pageIndices);
      copiedPages.forEach((page) => newDoc.addPage(page));

      const newBytes = await newDoc.save();
      const blob = new Blob([newBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);

      const baseName = currentFile?.name.replace(/\.[^/.]+$/, '') || 'document';
      const link = document.createElement('a');
      link.href = url;
      link.download = `${baseName}_pages_${selectedPages.join('_')}.pdf`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      setTimeout(() => URL.revokeObjectURL(url), 5000);
      showStatus(`✓ Successfully extracted ${selectedPages.length} pages to new PDF! Download started.`);
    } catch (err: any) {
      console.error(err);
      showStatus(`Failed to extract pages: ${err.message || 'Unknown error'}`, true);
    } finally {
      executeBtn.removeAttribute('disabled');
    }
  });
</script>
