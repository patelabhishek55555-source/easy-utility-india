---
import type { Tool } from '../../config/tools';

export interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

const categoryColors = {
  pdf: {
    bg: 'bg-rose-50 text-rose-700 border-rose-200',
    iconBg: 'bg-rose-100 text-rose-600 group-hover:bg-rose-600 group-hover:text-white',
    label: 'PDF Tool',
  },
  image: {
    bg: 'bg-sky-50 text-sky-700 border-sky-200',
    iconBg: 'bg-sky-100 text-sky-600 group-hover:bg-sky-600 group-hover:text-white',
    label: 'Image Tool',
  },
  calculator: {
    bg: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    iconBg: 'bg-emerald-100 text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white',
    label: 'Calculator',
  },
};

const currentCat = categoryColors[tool.category] || categoryColors.pdf;
---

<a
  href={`/tools/${tool.slug}`}
  class="group card-tool p-5 sm:p-6 flex flex-col justify-between relative overflow-hidden transition-all duration-200"
  data-tool-card
  data-title={tool.title.toLowerCase()}
  data-category={tool.category}
  data-keywords={`${tool.title} ${tool.shortTitle} ${tool.description} ${tool.category}`.toLowerCase()}
>
  <div>
    <!-- Top Row: Category & Badges -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class={`text-[11px] font-semibold px-2.5 py-0.5 rounded-full border ${currentCat.bg}`}>
        {currentCat.label}
      </span>
      {tool.badge && (
        <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-brand-50 text-brand-700 border border-brand-200">
          {tool.badge}
        </span>
      )}
    </div>

    <!-- Icon & Title -->
    <div class="flex items-start gap-3.5 mb-3">
      <div class={`w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0 transition-colors duration-200 ${currentCat.iconBg}`}>
        {tool.icon === 'FileImage' && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        )}
        {tool.icon === 'Copy' && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        )}
        {tool.icon === 'Split' && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
          </svg>
        )}
        {tool.icon === 'Eye' && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        )}
        {tool.icon === 'Maximize2' && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
          </svg>
        )}
        {tool.icon === 'Minimize2' && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 14h6m0 0v6m0-6L3 21m17-7h-6m0 0v6m0-6l7 7M10 10H4m6 0V4m0 6L3 3m11 7h6m-6 0V4m0 6l7-7" />
          </svg>
        )}
        {tool.icon === 'Repeat' && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        )}
        {tool.icon === 'Calendar' && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        )}
        {tool.icon === 'Percent' && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0zm11 5a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
          </svg>
        )}
        {tool.icon === 'Tag' && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
        )}
      </div>

      <div class="flex-1 min-w-0">
        <h3 class="font-semibold text-slate-900 group-hover:text-brand-600 transition-colors text-base line-clamp-1">
          {tool.title}
        </h3>
        <p class="text-xs text-slate-500 mt-1 line-clamp-2 leading-relaxed">
          {tool.description}
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom Action Link -->
  <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-medium text-brand-600 group-hover:text-brand-700">
    <span>Open Tool</span>
    <span class="group-hover:translate-x-1 transition-transform duration-200">→</span>
  </div>
</a>
