---
import { siteConfig } from '../../config/site';
---

<footer class="bg-navy-900 text-slate-300 mt-20 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      
      <!-- Column 1: Brand & Mission -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-blue-400 flex items-center justify-center text-white shadow-md relative overflow-hidden">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <div class="absolute bottom-0 left-0 right-0 h-1 flex">
              <span class="w-1/3 bg-amber-500"></span>
              <span class="w-1/3 bg-white"></span>
              <span class="w-1/3 bg-emerald-600"></span>
            </div>
          </div>
          <div>
            <span class="font-bold text-xl text-white tracking-tight">Easy Utility <span class="text-brand-400">India</span></span>
          </div>
        </div>
        
        <p class="text-sm text-slate-400 leading-relaxed">
          {siteConfig.tagline}. High-speed, 100% private online tools designed for Indian students, professionals, and everyday tasks. No server uploads.
        </p>

        <!-- Trust Badges -->
        <div class="pt-2 flex flex-col gap-2">
          <div class="flex items-center gap-2 text-xs text-emerald-400">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>Zero Server Storage: Privacy by Design</span>
          </div>
          <div class="flex items-center gap-2 text-xs text-brand-300">
            <svg class="w-4 h-4 text-brand-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
            </svg>
            <span>Unlimited Free Usage - No Watermarks</span>
          </div>
        </div>
      </div>

      <!-- Column 2: Popular Tools -->
      <div>
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">Popular Tools</h3>
        <ul class="space-y-2.5 text-sm">
          {siteConfig.footerLinks.tools.slice(0, 5).map((tool) => (
            <li>
              <a href={tool.href} class="text-slate-400 hover:text-white transition-colors flex items-center gap-1.5">
                <span class="text-brand-500 font-mono text-xs">›</span>
                <span>{tool.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: More Tools -->
      <div>
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">Calculators & Image</h3>
        <ul class="space-y-2.5 text-sm">
          {siteConfig.footerLinks.tools.slice(5).map((tool) => (
            <li>
              <a href={tool.href} class="text-slate-400 hover:text-white transition-colors flex items-center gap-1.5">
                <span class="text-brand-500 font-mono text-xs">›</span>
                <span>{tool.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Company & Legal -->
      <div>
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">Quick Links & Legal</h3>
        <ul class="space-y-2.5 text-sm">
          {siteConfig.footerLinks.company.map((item) => (
            <li>
              <a href={item.href} class="text-slate-400 hover:text-white transition-colors flex items-center gap-1.5">
                <span class="text-slate-600 font-mono text-xs">›</span>
                <span>{item.name}</span>
              </a>
            </li>
          ))}
          {siteConfig.footerLinks.legal.map((item) => (
            <li>
              <a href={item.href} class="text-slate-400 hover:text-white transition-colors flex items-center gap-1.5">
                <span class="text-slate-600 font-mono text-xs">›</span>
                <span>{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom Line -->
    <div class="mt-12 pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {new Date().getFullYear()} Easy Utility India. Built for speed, privacy, and simplicity. Made with pride for India.</p>
      <div class="flex items-center gap-4">
        <a href="/privacy-policy" class="hover:text-slate-400 transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-slate-400 transition-colors">Terms</a>
        <a href="/disclaimer" class="hover:text-slate-400 transition-colors">Disclaimer</a>
        <a href="/sitemap-index.xml" class="hover:text-slate-400 transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
